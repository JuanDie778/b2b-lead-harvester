# ============================================================
# B2B Lead Harvester - Environment Configuration Template
# ============================================================
# Copy this file to .env and fill in your actual credentials.
# NEVER commit your .env file containing live credentials to git!

# LinkedIn Authentication Credentials
LINKEDIN_EMAIL=your_email@example.com
LINKEDIN_PASSWORD=your_secure_password_here

# Scraper Engine Configuration
HEADLESS_MODE=true
BROWSER_TIMEOUT_MS=30000
REQUEST_DELAY_MIN=2.0
REQUEST_DELAY_MAX=5.0

# Persistence & Storage
DATA_DIR=./data
DATABASE_NAME=leads.db

# Telemetry & Logging
LOG_LEVEL=INFO
